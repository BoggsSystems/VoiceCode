<policies>
    <inbound>
        <base />
        
        <!-- STT-specific rate limiting (lower for audio processing) -->
        <rate-limit-by-key calls="100" renewal-period="60" counter-key="@(context.Subscription?.Key ?? "anonymous")" />
        
        <!-- Validate content type for audio endpoints -->
        <choose>
            <when condition="@(context.Request.Url.Path.Contains("/transcribe") && !context.Request.Headers.GetValueOrDefault("Content-Type", "").Contains("audio/"))">
                <return-response>
                    <set-status code="415" reason="Unsupported Media Type" />
                    <set-body>{"error": "unsupported_media_type", "message": "Audio content type required"}</set-body>
                </return-response>
            </when>
        </choose>
        
        <!-- Add service-specific headers -->
        <set-header name="X-Service-Name" exists-action="override">
            <value>STT-Service</value>
        </set-header>
        
        <!-- Request size limit for audio (10MB) -->
        <choose>
            <when condition="@(context.Request.Body != null && context.Request.Headers.GetValueOrDefault("Content-Length", "0").Length > 10485760)">
                <return-response>
                    <set-status code="413" reason="Payload Too Large" />
                    <set-body>{"error": "payload_too_large", "message": "Audio file exceeds 10MB limit"}</set-body>
                </return-response>
            </when>
        </choose>
    </inbound>
    
    <backend>
        <base />
        <!-- Circuit breaker pattern -->
        <retry condition="@(context.Response.StatusCode >= 500)" count="2" interval="1">
            <forward-request timeout="30" />
        </retry>
    </backend>
    
    <outbound>
        <base />
        
        <!-- Cache transcription results for repeated requests -->
        <cache-store duration="300" cache-response="true" />
        
        <!-- Add STT-specific response headers -->
        <set-header name="X-Audio-Duration" exists-action="skip">
            <value>@(context.Response.Headers.GetValueOrDefault("X-Audio-Duration", ""))</value>
        </set-header>
        <set-header name="X-Transcription-Confidence" exists-action="skip">
            <value>@(context.Response.Headers.GetValueOrDefault("X-Transcription-Confidence", ""))</value>
        </set-header>
    </outbound>
    
    <on-error>
        <base />
    </on-error>
</policies>