{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "yourdomain.onmicrosoft.com",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "Scopes": "access_as_user",
    "CallbackPath": "/signin-oidc"
  },
  "Generator": {
    "Languages": {
      "csharp": {
        "FileExtension": "cs",
        "DefaultIndentation": "    ",
        "StandardImports": [ "System", "System.Collections.Generic", "System.Linq" ],
        "CodeStyle": {
          "NamingConvention": "PascalCase",
          "UseExplicitTypes": true,
          "PreferAsync": true,
          "LineEnding": "\n",
          "MaxLineLength": 120
        }
      },
      "typescript": {
        "FileExtension": "ts",
        "DefaultIndentation": "  ",
        "StandardImports": [],
        "CodeStyle": {
          "NamingConvention": "camelCase",
          "UseExplicitTypes": true,
          "PreferAsync": true,
          "LineEnding": "\n",
          "MaxLineLength": 100
        }
      },
      "python": {
        "FileExtension": "py",
        "DefaultIndentation": "    ",
        "StandardImports": [],
        "CodeStyle": {
          "NamingConvention": "snake_case",
          "UseExplicitTypes": false,
          "PreferAsync": true,
          "LineEnding": "\n",
          "MaxLineLength": 88
        }
      }
    },
    "MaxFilesPerGeneration": 20,
    "MaxFileSizeKb": 100,
    "ValidateGeneratedCode": true,
    "FormatGeneratedCode": true,
    "DefaultFileEncoding": "UTF-8"
  },
  "Templates": {
    "TemplatesPath": "Templates",
    "EnableCustomTemplates": true,
    "CacheCompiledTemplates": true,
    "GlobalVariables": {
      "year": "2024",
      "company": "VoiceCode",
      "version": "1.0.0"
    }
  },
  "ClaudeService": {
    "BaseUrl": "http://claude-service"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "ServiceBus": "Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key"
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=your-key;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus.livediagnostics.monitor.azure.com/"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://yourdomain.com",
      "https://yellow-coast-05996a50f.1.azurestaticapps.net"
    ]
  },
  "KeyVaultName": "voicecode-keyvault",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.ApplicationInsights" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}