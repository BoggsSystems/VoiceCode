{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Claude": {
    "ApiKey": "development-claude-key",
    "MaxTokens": 2000,
    "Temperature": 0.7,
    "MaxRetries": 2,
    "Timeout": "00:01:00"
  },
  "ResponseInterpreter": {
    "ApiKey": "development-openai-key",
    "MaxSummaryLength": 30
  },
  "RateLimit": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}