FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

# Install Node.js 20.x and dependencies
RUN apt-get update && \
    apt-get install -y curl git gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Verify Node.js installation
RUN node --version && npm --version

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Verify Claude Code installation and location
RUN which claude || which claude-code || echo "Claude Code not found in PATH"
RUN ls -la /usr/local/bin/claude* || echo "No claude binaries in /usr/local/bin"
RUN ls -la /usr/bin/claude* || echo "No claude binaries in /usr/bin"
RUN claude --version || claude-code --version || echo "Claude Code version check failed"

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["services/worker-service/VoiceCode.WorkerService.csproj", "services/worker-service/"]
COPY ["shared/VoiceCode.Common/VoiceCode.Common.csproj", "shared/VoiceCode.Common/"]
RUN dotnet restore "services/worker-service/VoiceCode.WorkerService.csproj"
COPY . .
WORKDIR "/src/services/worker-service"
RUN dotnet build "VoiceCode.WorkerService.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "VoiceCode.WorkerService.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Copy startup script
COPY services/worker-service/startup.sh /startup.sh
RUN chmod +x /startup.sh

# Create workspace directory
RUN mkdir -p /workspace && chmod 777 /workspace
RUN mkdir -p /workspaces && chmod 777 /workspaces

# Set environment variables
ENV ASPNETCORE_URLS=http://+:80
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
ENV WORKSPACE_DIR=/workspace
ENV SHALLOW_CLONE=true

# Claude Code will be available in PATH
# We'll determine the actual binary name during build
ENV Mcp__ServerExecutable=claude
ENV Mcp__ServerArguments="--mcp"

# Create entrypoint script
RUN echo '#!/bin/bash\n\
echo "Claude Code location: $(which claude || which claude-code || echo 'not found')"\n\
echo "PATH: $PATH"\n\
/startup.sh\n\
echo "Starting .NET application..."\n\
exec dotnet VoiceCode.WorkerService.dll' > /entrypoint.sh && \
chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]