{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Worker": {
    "ClaudeApiKey": "",
    "ClaudeModel": "claude-3-opus-20240229",
    "WorkspaceBasePath": "/workspaces",
    "MaxConcurrentWorkers": 5,
    "WorkerTimeoutMinutes": 30,
    "EnableMcpServer": false,
    "McpTransport": "stdio",
    "McpServerPort": 3000
  },
  "Mcp": {
    "TransportType": "stdio",
    "ServerExecutable": "claude-code",
    "ServerArguments": ["api", "--mode", "mcp-server"],
    "ConnectionTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 600,
    "EnableLogging": true,
    "LogLevel": "Information"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}