{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "your-tenant-id",
    "ClientId": "your-client-id",
    "Scopes": "access_as_user"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Storage": "UseDevelopmentStorage=true"
  },
  "AzureSpeech": {
    "Key": "",
    "Region": "eastus",
    "Endpoint": "",
    "UseCustomEndpoint": false,
    "MaxConcurrentSynthesis": 50,
    "SynthesisTimeout": "00:00:30"
  },
  "Voice": {
    "Profiles": {
      "default": {
        "Name": "default",
        "Voice": "en-US-JennyNeural",
        "Language": "en-US",
        "Style": {
          "Style": "friendly",
          "StyleDegree": 1.0,
          "Role": "Assistant"
        },
        "Prosody": {
          "Rate": "1.0",
          "Pitch": "0%",
          "Volume": "100"
        }
      },
      "friendly": {
        "Name": "friendly",
        "Voice": "en-US-JennyNeural",
        "Language": "en-US",
        "Style": {
          "Style": "friendly",
          "StyleDegree": 1.2,
          "Role": "Friend"
        },
        "Prosody": {
          "Rate": "1.05",
          "Pitch": "+5%",
          "Volume": "105"
        }
      },
      "professional": {
        "Name": "professional",
        "Voice": "en-US-AriaNeural",
        "Language": "en-US",
        "Style": {
          "Style": "professional",
          "StyleDegree": 1.0,
          "Role": "Professional"
        },
        "Prosody": {
          "Rate": "0.95",
          "Pitch": "0%",
          "Volume": "100"
        }
      },
      "casual": {
        "Name": "casual",
        "Voice": "en-US-GuyNeural",
        "Language": "en-US",
