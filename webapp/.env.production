# Production environment configuration for VoiceCode
# Azure Container Instances endpoints

# Core API Services
REACT_APP_API_BASE_URL=https://voicecode-router.orangewater-a2f689a8.eastus.azurecontainerapps.io
REACT_APP_ROUTER_SERVICE_URL=https://voicecode-router.orangewater-a2f689a8.eastus.azurecontainerapps.io
REACT_APP_DISPATCHER_SERVICE_URL=https://voicecode-dispatcher.orangewater-a2f689a8.eastus.azurecontainerapps.io
REACT_APP_GENERATOR_SERVICE_URL=http://52.226.90.226

# AI Services
REACT_APP_CLAUDE_SERVICE_URL=http://4.157.96.157
REACT_APP_STT_SERVICE_URL=https://voicecode-stt.orangewater-a2f689a8.eastus.azurecontainerapps.io
REACT_APP_TTS_SERVICE_URL=https://voicecode-tts.orangewater-a2f689a8.eastus.azurecontainerapps.io

# WebSocket/SignalR endpoints
REACT_APP_SIGNALR_HUB_URL=https://voicecode-dispatcher.orangewater-a2f689a8.eastus.azurecontainerapps.io/hubs/voice
REACT_APP_WS_URL=wss://voicecode-dispatcher.orangewater-a2f689a8.eastus.azurecontainerapps.io/ws

# Static Web App URL (for CORS configuration)
REACT_APP_FRONTEND_URL=https://yellow-coast-05996a50f.1.azurestaticapps.net

# Feature flags
REACT_APP_ENABLE_VOICE_RECORDING=true
REACT_APP_ENABLE_CODE_GENERATION=true
REACT_APP_ENABLE_PROJECT_INTEGRATION=true

# Debugging (set to false in production)
REACT_APP_DEBUG_MODE=false
REACT_APP_ENABLE_CONSOLE_LOGS=false

# Build settings
TSC_COMPILE_ON_ERROR=true
DISABLE_ESLINT_PLUGIN=true