FROM mcr.microsoft.com/dotnet/aspnet:8.0

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create a simple ASP.NET Core app inline
WORKDIR /app

# Create a minimal Program.cs
RUN echo 'var builder = WebApplication.CreateBuilder(args);' > Program.cs && \
    echo 'var app = builder.Build();' >> Program.cs && \
    echo 'app.MapGet("/health", () => new { status = "healthy", service = Environment.GetEnvironmentVariable("SERVICE_NAME") ?? "unknown" });' >> Program.cs && \
    echo 'app.MapGet("/health/ready", () => new { ready = true });' >> Program.cs && \
    echo 'app.Run();' >> Program.cs

# Create a minimal csproj
RUN echo '<Project Sdk="Microsoft.NET.Sdk.Web">' > app.csproj && \
    echo '  <PropertyGroup>' >> app.csproj && \
    echo '    <TargetFramework>net8.0</TargetFramework>' >> app.csproj && \
    echo '  </PropertyGroup>' >> app.csproj && \
    echo '</Project>' >> app.csproj

# Build the app
RUN dotnet publish -c Release -o out

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=0 /app/out .

ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80

ENTRYPOINT ["dotnet", "app.dll"]
